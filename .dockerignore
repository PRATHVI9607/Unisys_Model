# Build context excludes — keep images small and builds deterministic.
.git
.gitignore
.venv
.codegraph
.claude
.github
.mcp.json
.ruff_cache

__pycache__/
*.py[cod]
*.so
*.egg-info/

# Tests, docs, assets — never needed in a runtime image.
tests/
docs/
*.md
*.docx
*.png
*.jpg
Screenshot*

# Training data (only needed at train time).
training/data/
data/
*.csv
*.jsonl

*.log
