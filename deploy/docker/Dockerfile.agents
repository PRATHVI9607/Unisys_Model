# One image for all three agents (health / security / fusion).
# The k8s manifest picks the module with its command, e.g.
#   command: ["python", "-m", "agents.fusion_agent.agent"]
#   docker build -t kubeheal.invalid/agents:v5 -f deploy/docker/Dockerfile.agents .
# Build: uv-managed standalone CPython + locked deps, pruned; runtime: distroless/cc (glibc, libstdc++,
# libgomp for LightGBM; no shell, no apt, no pip). Pattern: docs.astral.sh/uv/guides/integration/docker.
# Base images pinned by digest (multi-arch index); bump tag and digest together.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 /uv /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/python UV_PYTHON_PREFERENCE=only-managed
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv python install 3.13 && uv sync --frozen --no-dev --no-install-project --no-editable --extra agents
# Never used at runtime: libpython .so (bin/python3 is statically linked; no embedders here), CPython test
# suite/IDLE/Tk/ensurepip/pip/headers, -O/-OO bytecode, type stubs/C headers, packages' tests/.
RUN for d in /python/cpython-*; do [ -L "$d" ] || (cd "$d" && rm -rf include share lib/libpython3* bin/pip* bin/idle* lib/tcl* lib/tk* lib/itcl* lib/thread* \
      lib/libtcl* lib/libtk* lib/python3.*/test lib/python3.*/idlelib lib/python3.*/tkinter lib/python3.*/turtledemo \
      lib/python3.*/ensurepip lib/python3.*/config-* lib/python3.*/lib-dynload/_tkinter* lib/python3.*/site-packages/pip*); done \
 && find /python /app/.venv \( -name '*.opt-[12].pyc' -o -name '*.pyi' -o -name '*.pxd' -o -name '*.h' \) -delete \
 && find /app/.venv/lib/python3.*/site-packages -depth -type d -name tests -exec rm -rf {} +
# lightgbm imports only scipy.sparse (lightgbm/basic.py): the rest of scipy and its OpenBLAS are dead weight (~90 MB). The
# train + predict check (last stage: the build stage has no libgomp) fails the build if a lightgbm upgrade starts needing more.
RUN cd /app/.venv/lib/python3.*/site-packages && rm -rf scipy.libs \
      scipy/stats scipy/optimize scipy/spatial scipy/io scipy/signal scipy/interpolate scipy/fft scipy/ndimage scipy/integrate scipy/odr \
      scipy/misc scipy/fftpack scipy/differentiate scipy/datasets scipy/cluster scipy/constants scipy/special scipy/linalg
# arch-neutral staging for the final stage (x86_64-linux-gnu or aarch64-linux-gnu)
RUN mkdir /zlib && cp -a /usr/lib/*-linux-gnu/libz.so.1* /zlib/

FROM gcr.io/distroless/cc-debian12:latest@sha256:e5d81ddde149641e2a9ba55be4545bc125c67de07508b03ba4c22e6eb0ded5aa
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
# numpy's C extension links zlib, which distroless/cc lacks (same bookworm ABI as the build stage). /usr/lib is on
# ld.so's default path on both amd64 and arm64.
COPY --from=build /zlib/ /usr/lib/
COPY --from=build /python /python
COPY --from=build /app/.venv /app/.venv
COPY kubeheal/ kubeheal/
COPY agents/ agents/
# The security agent scores in-process (SECURITY_MODEL_DIR default /models/security); inference is only its fallback.
COPY models/security /models/security
# Compile our sources too: the root fs is read-only at runtime, so Python could not cache .pyc.
RUN ["python", "-m", "compileall", "-q", "kubeheal", "agents"]
# lightgbm still has what it imports (scipy.sparse): train, predict and TreeSHAP in the final image.
RUN ["python", "-c", "import lightgbm as l, numpy as n; l.train({'verbose': -1}, l.Dataset(n.random.rand(50, 3), n.arange(50) % 2), 2).predict(n.random.rand(2, 3), pred_contrib=True)"]
USER 10001
# No CMD: each manifest sets `command` to the agent it runs.
