# Chaos tool for the demo: a non-destructive detection test workload that writes
# high-entropy data into files it creates in a marked sandbox, to exercise the
# security agent. Stdlib only, no deps. Refuses to run outside a marked sandbox
# (see deploy/chaos/detection-test-workload.py).
#   docker build -t kubeheal/chaos:v5 -f deploy/docker/Dockerfile.chaos .
FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1
WORKDIR /app
COPY deploy/chaos/detection-test-workload.py /app/detection-test-workload.py
USER 10001
ENTRYPOINT ["python", "/app/detection-test-workload.py"]
