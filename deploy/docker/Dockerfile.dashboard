# FastAPI + static JS console (port 8080).
#   docker build -t kubeheal.invalid/dashboard:v5 -f deploy/docker/Dockerfile.dashboard .
# Build: uv-managed standalone CPython + locked deps, pruned; runtime: distroless/cc (glibc, libstdc++,
# libgomp for LightGBM; no shell, no apt, no pip). Pattern: docs.astral.sh/uv/guides/integration/docker.
# Base images pinned by digest (multi-arch index); bump tag and digest together.
FROM debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc AS build
COPY --from=ghcr.io/astral-sh/uv:0.13.0@sha256:cdc6093146eb3ff6a40107b38f008b789e050e77ad87865e381d9917da55a168 /uv /bin/
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_INSTALL_DIR=/python UV_PYTHON_PREFERENCE=only-managed
WORKDIR /app
RUN --mount=type=cache,target=/root/.cache/uv \
    --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    uv python install 3.13 && uv sync --frozen --no-dev --no-install-project --no-editable --extra dashboard
# Never used at runtime: libpython .so (bin/python3 is statically linked; no embedders here), CPython test
# suite/IDLE/Tk/ensurepip/pip/headers, -O/-OO bytecode, type stubs/C headers, packages' tests/.
RUN for d in /python/cpython-*; do [ -L "$d" ] || (cd "$d" && rm -rf include share lib/libpython3* bin/pip* bin/idle* lib/tcl* lib/tk* lib/itcl* lib/thread* \
      lib/libtcl* lib/libtk* lib/python3.*/test lib/python3.*/idlelib lib/python3.*/tkinter lib/python3.*/turtledemo \
      lib/python3.*/ensurepip lib/python3.*/config-* lib/python3.*/lib-dynload/_tkinter* lib/python3.*/site-packages/pip*); done \
 && find /python /app/.venv \( -name '*.opt-[12].pyc' -o -name '*.pyi' -o -name '*.pxd' -o -name '*.h' \) -delete \
 && find /app/.venv/lib/python3.*/site-packages -depth -type d -name tests -exec rm -rf {} +

FROM gcr.io/distroless/cc-debian12:latest@sha256:e5d81ddde149641e2a9ba55be4545bc125c67de07508b03ba4c22e6eb0ded5aa
ENV PYTHONUNBUFFERED=1 PATH="/app/.venv/bin:$PATH"
WORKDIR /app
# numpy's C extension links zlib, which distroless/cc lacks (same bookworm ABI as the build stage).
# shortcut: amd64 lib path; arm64 builds need aarch64-linux-gnu here.
COPY --from=build /usr/lib/x86_64-linux-gnu/libz.so.1* /usr/lib/x86_64-linux-gnu/
COPY --from=build /python /python
COPY --from=build /app/.venv /app/.venv
COPY kubeheal/ kubeheal/
COPY dashboard/ dashboard/
# Compile our sources too: the root fs is read-only at runtime, so Python could not cache .pyc.
RUN ["python", "-m", "compileall", "-q", "kubeheal", "dashboard"]
USER 10001
CMD ["uvicorn", "dashboard.fastapi_app:app", "--host", "0.0.0.0", "--port", "8080"]
