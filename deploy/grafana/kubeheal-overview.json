      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum by (le, model) (rate(kubeheal_model_latency_seconds_bucket[5m])))", "legendFormat": "{{model}} p95", "refId": "A" }
      ],
      "title": "Model latency p95",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
