      "options": { "legend": { "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "kubeheal_queue_depth", "legendFormat": "{{stream}}", "refId": "A" },
        { "expr": "kubeheal_stream_lag", "legendFormat": "{{stream}} lag", "refId": "B" }
