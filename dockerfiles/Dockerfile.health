FROM python:3.11-slim
COPY --from=ghcr.io/astral-sh/uv:0.5.11 /uv /uvx /bin/
ENV UV_NO_CACHE=1 UV_SYSTEM_PYTHON=1
WORKDIR /app
RUN uv pip install --system \
    kubernetes-asyncio==29.0.1 "redis>=5.0.1,<6" pydantic==2.6.0 \
    aiohttp==3.9.0 prometheus-api-client "numpy<2" "prometheus-client>=0.20.0"
COPY agents/ /app/agents/
COPY kubeheal/ /app/kubeheal/
# torch-free metric schema the health agent imports (NOT the torch encoder); the agent also imports kubeheal/.
# models/ is a PEP-420 namespace package (no __init__.py needed).
COPY models/health_model/metric_schema.py /app/models/health_model/metric_schema.py
COPY models/health_model/preprocess.py /app/models/health_model/preprocess.py
ENV REDIS_URL=redis://redis-master:6379
ENV PROMETHEUS_URL=http://prometheus-operated.monitoring.svc.cluster.local:9090
ENV NAMESPACE=kubeheal
ENV METRICS_PORT=8080
ENV LOG_LEVEL=INFO
EXPOSE 8080
CMD ["python", "-m", "agents.health_agent.agent"]
